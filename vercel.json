{
  "git": {
    "deploymentEnabled": {
      "gh-pages": false
    }
  },
  "rewrites": [
    {
      "source": "/run/:path*",
      "destination": "/run/index.html"
    }
  ],
  "buildCommand": "pnpm build --base=/run/ --outDir=dist/run",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "destination": "https://zerosrat.dev/run/",
      "permanent": true
    },
    {
      "source": "/summary",
      "destination": "https://zerosrat.dev/run/summary",
      "permanent": true
    },
    {
      "source": "/tracks",
      "destination": "https://zerosrat.dev/run/tracks",
      "permanent": true
    },
    {
      "source": "/run",
      "destination": "/run/",
      "permanent": true
    }
  ]
}
